    old "{i}'Di mansion yang penuh dengan tipu daya dan kepalsuan ini, rasa terima kasih dan perasaanku kepadamu adalah satu-satunya hal yang nyata.'{/i}"
    new "{i}'Within this manor of deception and falsehood, my gratitude and affection for you are the solitary true things.'{/i}"

