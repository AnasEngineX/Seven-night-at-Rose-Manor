dialogue.tab
dialogue.txt
strings.json

# Temporary directories and build artifacts
tmp/
*-dists/
*-release/
tl_cache.json
*_test.png

# OS and Editor configurations
.vscode/
.idea/
.gemini/
.agents/
Thumbs.db
.DS_Store
